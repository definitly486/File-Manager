<?xml version="1.0" encoding="utf-8"?>
<org.fossify.filemanager.fragments.ItemsFragment xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/items_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/items_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:id="@+id/items_wrapper"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Kept (hidden) only because it tracks the folder stack used for navigation -->
            <org.fossify.commons.views.Breadcrumbs
                android:id="@+id/breadcrumbs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />


            <LinearLayout
                android:id="@+id/items_header"
                android:layout_width="match_parent"
                android:background="#312F32"
                android:layout_toStartOf="@+id/items_side_buttons"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/small_margin"
                    android:paddingTop="@dimen/small_margin"
                    android:paddingEnd="@dimen/bigger_margin">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/path_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="start"
                        android:maxLines="1"
                        android:textSize="@dimen/smaller_text_size" />

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/selection_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:paddingStart="@dimen/medium_margin"
                        android:textSize="@dimen/smaller_text_size" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/items_header_actions"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="#312F32"
                    android:paddingStart="@dimen/small_margin"
                    android:paddingEnd="@dimen/small_margin">

                    <LinearLayout
                        android:id="@+id/parent_dir_holder"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:contentDescription="@null"
                            android:padding="0dp"
                            android:src="@drawable/tc_updir" />

                        <org.fossify.commons.views.MyTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/tiny_margin"
                            android:text=".."
                            android:textSize="@dimen/normal_text_size" />
                    </LinearLayout>

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/free_space_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:paddingEnd="@dimen/medium_margin"
                        android:textSize="@dimen/smaller_text_size" />

                    <ImageView
                        android:id="@+id/refresh_button"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="0dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@null"
                        android:padding="0dp"
                        android:src="@drawable/tc_reload" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#40FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/items_side_buttons"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="28dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/side_copy"
                    android:layout_width="44dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/copy_to"
                    android:padding="10dp"
                    android:src="@drawable/ic_side_arrow_vector" />

                <ImageView
                    android:id="@+id/side_move"
                    android:layout_width="44dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/move_to"
                    android:padding="10dp"
                    android:src="@drawable/ic_side_arrow_vector" />

                <ImageView
                    android:id="@+id/side_open"
                    android:layout_width="44dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:padding="10dp"
                    android:src="@drawable/ic_side_arrow_vector" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="16dp" />

                <ImageView
                    android:id="@+id/side_select_all"
                    android:layout_width="44dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/select_all"
                    android:padding="10dp"
                    android:src="@drawable/ic_side_equal_vector" />

                <ImageView
                    android:id="@+id/side_invert"
                    android:layout_width="44dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/invert_selection"
                    android:padding="10dp"
                    android:src="@drawable/ic_side_equal_vector" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:indeterminate="true"
                android:visibility="gone"
                app:hideAnimationBehavior="outward"
                app:showAnimationBehavior="inward"
                app:showDelay="250"
                tools:visibility="visible" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/items_placeholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/items_header"
                android:layout_centerHorizontal="true"
                android:alpha="0.8"
                android:gravity="center"
                android:paddingStart="@dimen/activity_margin"
                android:paddingEnd="@dimen/activity_margin"
                android:text="@string/no_items_found"
                android:textSize="@dimen/bigger_text_size"
                android:textStyle="italic"
                android:visibility="gone" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/items_placeholder_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/items_placeholder"
                android:layout_centerHorizontal="true"
                android:alpha="0.8"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:padding="@dimen/activity_margin"
                android:text="@string/type_2_characters"
                android:textSize="@dimen/bigger_text_size"
                android:textStyle="italic"
                android:visibility="gone" />

            <org.fossify.filemanager.views.MySwipeRefreshLayout
                android:id="@+id/items_swipe_refresh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/items_header"
                android:layout_toStartOf="@+id/items_side_buttons">

                <com.qtalk.recyclerviewfastscroller.RecyclerViewFastScroller
                    android:id="@+id/items_fastscroller"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:supportSwipeToRefresh="true">

                    <org.fossify.commons.views.MyRecyclerView
                        android:id="@+id/items_list"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingBottom="116dp"
                        android:layoutAnimation="@anim/layout_animation"
                        android:scrollbars="none"
                        app:layoutManager="org.fossify.commons.views.MyGridLayoutManager" />

                </com.qtalk.recyclerviewfastscroller.RecyclerViewFastScroller>
            </org.fossify.filemanager.views.MySwipeRefreshLayout>
        </RelativeLayout>


        <LinearLayout
            android:id="@+id/items_bottom_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#40FFFFFF" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="64dp">

               <org.fossify.commons.views.MyFloatingActionButton
    android:id="@+id/items_fab"
    android:layout_width="64dp"
    android:layout_height="64dp"
    android:layout_gravity="start|center_vertical"
    android:src="@drawable/ic_plus_vector"
    app:maxImageSize="40dp"
    app:elevation="0dp"
    app:pressedTranslationZ="0dp"
    app:shapeAppearanceOverlay="@style/SquareShape" />
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#40FFFFFF" />

            <LinearLayout
                android:id="@+id/items_bottom_bar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_gravity="bottom"
                android:gravity="start"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/bar_menu"
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="@string/more_options"
                    android:paddingStart="8dp"
                    android:paddingTop="11dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="11dp"
                    android:src="@drawable/ic_bar_menu_vector" />

                <ImageView
                    android:id="@+id/bar_new_file"
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="@string/new_file"
                    android:paddingStart="8dp"
                    android:paddingTop="11dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="11dp"
                    android:src="@drawable/tc_bar_new_file" />

                <ImageView
                    android:id="@+id/bar_new_folder"
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="@string/new_folder"
                    android:paddingStart="8dp"
                    android:paddingTop="11dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="11dp"
                    android:src="@drawable/tc_bar_new_folder" />

                <ImageView
                    android:id="@+id/bar_delete"
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="@string/delete"
                    android:paddingStart="8dp"
                    android:paddingTop="11dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="11dp"
                    android:src="@drawable/tc_bar_delete" />

                <ImageView
                    android:id="@+id/bar_sort"
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="@string/sort_by"
                    android:paddingStart="8dp"
                    android:paddingTop="11dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="11dp"
                    android:src="@drawable/tc_bar_sort" />

                <ImageView
                    android:id="@+id/bar_swap"
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="@string/swap_selection"
                    android:paddingStart="8dp"
                    android:paddingTop="11dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="11dp"
                    android:src="@drawable/tc_bar_swap" />
            </LinearLayout>

        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</org.fossify.filemanager.fragments.ItemsFragment>
