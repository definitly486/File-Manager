<resources>

    <style name="AppTheme" parent="AppTheme.Base">
        <!-- Also on activity theme so framework overflow picks it up if used -->
        <item name="actionOverflowMenuStyle">@style/TcOverflowMenu</item>
        <item name="popupMenuStyle">@style/TcPopupMenu</item>
        <item name="android:popupMenuStyle">@style/TcPopupMenu</item>
    </style>

    <style name="SquareShape">
        <item name="cornerSize">0dp</item>
    </style>

    <style name="TcPopupMenu" parent="@style/Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/tc_popup_background</item>
    </style>

    <style name="TcOverflowMenu" parent="@style/Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/tc_popup_background</item>
        <item name="overlapAnchor">false</item>
    </style>

    <style name="TcPopupMenuOverlay" parent="@style/ThemeOverlay.AppCompat.Dark">
        <item name="popupMenuStyle">@style/TcPopupMenu</item>
        <item name="android:popupMenuStyle">@style/TcPopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/TcOverflowMenu</item>
        <item name="android:colorBackground">#201E21</item>
        <item name="android:panelBackground">@drawable/tc_popup_background</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#B3FFFFFF</item>
    </style>

</resources>
